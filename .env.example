# --- General ---
APP_NAME=DocuMind
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=documind_neo4j

# --- ChromaDB ---
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=documind_chunks

# --- LLM / VLM ---
# 'gemini' (hosted, needs GEMINI_API_KEY) or 'ollama' (local, needs Ollama running)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=qwen3-vl:4b

# --- Embeddings / Reranker ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- OCR ---
PADDLEOCR_LANG=en
PADDLEOCR_USE_GPU=false

# --- Storage ---
STORAGE_ROOT=storage
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.bmp

# --- RAG ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# --- WebSocket ---
WS_HEARTBEAT_SECONDS=30

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
